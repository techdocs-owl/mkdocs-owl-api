{
  "type": "object",
  "title": "Pet",
  "description": "A pet in the store.",
  "required": [
    "name",
    "photoUrls"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64",
      "readOnly": true
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "examples": [
        "doggie"
      ]
    },
    "category": {
      "$ref": "#/components/schemas/Category",
      "description": "Grouping this pet belongs to."
    },
    "owner": {
      "$ref": "#/components/schemas/User",
      "readOnly": true
    },
    "photoUrls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/Tag"
      }
    },
    "status": {
      "type": "string",
      "description": "pet status in the store",
      "enum": [
        "available",
        "pending",
        "sold"
      ],
      "default": "available"
    },
    "weight": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nickname": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string",
      "default": null
    }
  }
}
