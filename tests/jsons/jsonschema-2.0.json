{
  "type": "object",
  "title": "Pet",
  "description": "A pet in the store.",
  "required": [
    "name",
    "photoUrls"
  ],
  "xml": {
    "name": "Pet"
  },
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64",
      "readOnly": true
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "example": "doggie"
    },
    "category": {
      "$ref": "#/definitions/Category",
      "description": "Grouping this pet belongs to."
    },
    "owner": {
      "$ref": "#/definitions/User",
      "readOnly": true
    },
    "photoUrls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Tag",
        "xml": {
          "name": "tag"
        }
      }
    },
    "status": {
      "type": "string",
      "description": "pet status in the store",
      "enum": [
        "available",
        "pending",
        "sold"
      ],
      "default": "available"
    },
    "weight": {
      "type": "number",
      "minimum": 0,
      "exclusiveMinimum": true
    },
    "nickname": {
      "type": "string",
      "x-nullable": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string",
      "default": null
    }
  }
}
