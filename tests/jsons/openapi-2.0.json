{
  "swagger": "2.0",
  "info": {
    "title": "Petstore",
    "version": "1.0.0",
    "description": "Pets, mostly.",
    "contact": {
      "name": "Team",
      "email": "team@example.test"
    },
    "license": {
      "name": "MIT"
    }
  },
  "host": "api.example.test",
  "basePath": "/v1",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "tags": [
    {
      "name": "pets",
      "description": "Pet operations"
    }
  ],
  "securityDefinitions": {
    "api_key": {
      "type": "apiKey",
      "name": "api_key",
      "in": "header"
    }
  },
  "security": [
    {
      "api_key": []
    }
  ],
  "parameters": {
    "PageSize": {
      "name": "limit",
      "in": "query",
      "description": "How many.",
      "type": "integer",
      "format": "int32"
    }
  },
  "paths": {
    "/pets": {
      "get": {
        "tags": [
          "pets"
        ],
        "summary": "List pets",
        "operationId": "listPets",
        "parameters": [
          {
            "$ref": "#/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "A list.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Pet"
              }
            }
          },
          "default": {
            "description": "Error.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "post": {
        "tags": [
          "pets"
        ],
        "summary": "Add a pet",
        "operationId": "addPet",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "The pet.",
            "schema": {
              "$ref": "#/definitions/Pet"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created.",
            "schema": {
              "$ref": "#/definitions/Pet"
            }
          }
        }
      }
    },
    "/pets/{petId}": {
      "parameters": [
        {
          "name": "petId",
          "in": "path",
          "required": true,
          "description": "Pet id.",
          "type": "string"
        }
      ],
      "get": {
        "tags": [
          "pets"
        ],
        "summary": "Get a pet",
        "operationId": "getPet",
        "security": [],
        "responses": {
          "200": {
            "description": "The pet.",
            "schema": {
              "$ref": "#/definitions/Pet"
            },
            "headers": {
              "X-Rate-Limit": {
                "type": "integer",
                "description": "Calls left."
              }
            }
          },
          "404": {
            "description": "Missing."
          }
        }
      }
    }
  },
  "definitions": {
    "Pet": {
      "type": "object",
      "title": "Pet",
      "description": "A pet in the store.",
      "required": [
        "name",
        "photoUrls"
      ],
      "xml": {
        "name": "Pet"
      },
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "example": "doggie"
        },
        "category": {
          "$ref": "#/definitions/Category",
          "description": "Grouping this pet belongs to."
        },
        "owner": {
          "$ref": "#/definitions/User",
          "readOnly": true
        },
        "photoUrls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Tag",
            "xml": {
              "name": "tag"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "pet status in the store",
          "enum": [
            "available",
            "pending",
            "sold"
          ],
          "default": "available"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": true
        },
        "nickname": {
          "type": "string",
          "x-nullable": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string",
          "default": null
        }
      }
    },
    "Error": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      }
    },
    "Category": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "Tag": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      }
    }
  },
  "externalDocs": {
    "url": "https://example.test/docs",
    "description": "More"
  }
}
